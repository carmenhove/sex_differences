@article{zaph_etal06,
  title = {Persistence and {{Function}} of {{Central}} and {{Effector Memory CD4}} + {{T Cells}} Following {{Infection}} with a {{Gastrointestinal Helminth}}},
  author = {Zaph, Colby and Rook, Kathryn A. and Goldschmidt, Michael and Mohrs, Markus and Scott, Phillip and Artis, David},
  year = 2006,
