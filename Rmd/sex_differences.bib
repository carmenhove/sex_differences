  issn = {14714906},
  doi = {10.1016/S1471-4906(03)00072-3},
  abstract = {Indoleamine 2,3-dioxygenase (IDO) degrades the indole moiety of tryptophan, serotonin and melatonin, and initiates the production of neuroactive and immunoregulatory metabolites, collectively known as kynurenines. By locally depleting tryptophan and increasing proapoptotic kynurenines, IDO expressed by dendritic cells (DCs) greatly affects T-cell proliferation and survival. IDO induction in DCs could be a common mechanism of deletional tolerance driven by regulatory T cells. Because such tolerogenic responses can be expected to operate in a variety of physiopathological conditions, tryptophan metabolism and kynurenine production might represent a crucial interface between the immune and nervous systems. This Opinion is the first in a series on the regulation of the immune system by metabolic pathways.},
  pmid = {12738417},
