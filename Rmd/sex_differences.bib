  number = {3},
  pages = {215--219},
  issn = {0015-5632},
  doi = {10.1007/s12223-012-0112-y},
  abstract = {There is no doubt about the beneficial effect of breastfeeding on the newborn's immune system. It is not fully elucidated what the differences are between the colostrum/milk of healthy and allergic mothers and how beneficial breastfeeding by an allergic mother is. The gene expression of selected cytokines was tested in cells isolated from colostra of healthy and allergic mothers using quantitative real-time PCR. Allergic phenotype was evident in colostral cells of allergic mothers: gene expressions of IL-4, IL-13 and EGF were increased and those of IFN-gamma decreased in comparison with colostral cells of healthy mothers. The allergic phenotype of the colostral cells of allergic mothers supporting the bias to a Th2 type response was found. It remains a question if a small number of these cells could influence the immature newborn immune system. \copyright{} 2012 Institute of Microbiology, Academy of Sciences of the Czech Republic, v.v.i.},
