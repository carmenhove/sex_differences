@article{adjei-boatengAgeDeterminationGrowth2013,
  title = {Age {{Determination}} and {{Growth Rate}} of the {{Freshwater Clam Galatea Paradoxa}} ( {{Born}} 1778 ) from the {{Volta River Estuary}} , {{Ghana}}},
