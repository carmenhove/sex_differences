@article{Witkin2011a,
  title = {Unique Alterations in Infection-Induced Immune Activation during Pregnancy},
  author = {Witkin, {\relax SS} and Linhares, {\relax IM} and Bongiovanni, {\relax AM} and Herway, C. and Skupski, D.},
  year = 2011,
