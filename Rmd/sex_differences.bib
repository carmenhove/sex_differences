@article{serin_etal16,
  title = {Is Neutrophil/Lymphocyte Ratio a Useful Marker to Predict the Severity of Pre-Eclampsia?},
  author = {Serin, Salih and Avci, Faz Il and Ercan, Onder and K{\"o}st{\"u}, B{\"u}lent and Bakacak, Murat and Kiran, Hakan},
  year = 2016,
