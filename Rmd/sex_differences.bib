  number = {1985},
  pages = {353--368},
  doi = {10.1002/9781118504338.ch19},
  abstract = {This chapter offers an epidemiologist's perspective on the second epidemiologic transition. It reviews the classic theory of epidemiologic transitions and its shortcomings. The chapter further discusses how the evolution of epidemiology as a discipline has veered both toward-in social epidemiology-and away from-within molecular and genetic epidemiology-embracing an overarching theory of population health. Epidemiology's scope has expanded to include not only so-called chronic conditions or noncommunicable diseases (NCDs), but also intentional and unintentional injury, mental disorders, well-being, and health-related behaviors and practices from lifestyle to medical interventions and health policy. The epidemiologic triad (or triangle) consisted of characterizing the presumptive causal agent, the susceptible host, and the environment that contributed to the development or maintenance of the agent, the susceptibility of the host, or likelihood of contact between the two. The chapter talks about the theory of epidemiologic transitions and the role of epidemiologic transition in the education of epidemiologists. \copyright{} 2014 by John Wiley \& Sons, Inc. All rights reserved.},
  isbn = {9781118504338},
  keywords = {Epidemiologic transition theory,Epidemiologic triangle,Epidemiologists,Noncommunicable diseases (NCDs),Second epidemiologic transition,Social epidemiology},
  file = {/Users/carmenhove/Zotero/storage/BHQ546EA/ch19.pdf}
}

