  pmid = {24635498},
  keywords = {Lymphocyte,Neutrophil,Preeclampsia,Pregnancy},
  file = {/Users/carmenhove/Zotero/storage/USZCSZDZ/May ratio of neutrophil to lymphocyte be useful in predicting the risk of developing preeclampsia A pilot study.pdf}
}

