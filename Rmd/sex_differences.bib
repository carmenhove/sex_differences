@article{taylor_etal23,
  title = {Ultrasensitive {{Detection}} of {{Circulating LINE-1 ORF1p}} as a {{Specific Multicancer Biomarker}}},
  author = {Taylor, Martin S. and Wu, Connie and Fridy, Peter C. and Zhang, Stephanie J. and Senussi, Yasmeen and Wolters, Justina C. and Cajuso, Tatiana and Cheng, Wen-Chih and Heaps, John D. and Miller, Bryant D. and Mori, Kei and Cohen, Limor and Jiang, Hua and Molloy, Kelly R. and Chait, Brian T. and Goggins, Michael G. and Bhan, Irun and Franses, Joseph W. and Yang, Xiaoyu and Taplin, Mary-Ellen and Wang, Xinan and Christiani, David C. and Johnson, Bruce E. and Meyerson, Matthew and Uppaluri, Ravindra and Egloff, Ann Marie and Denault, Elyssa N. and Spring, Laura M. and Wang, Tian-Li and Shih, Ie-Ming and Fairman, Jennifer E. and Jung, Euihye and Arora, Kshitij S. and Yilmaz, Osman H. and Cohen, Sonia and Sharova, Tatyana and Chi, Gary and Norden, Bryanna L. and Song, Yuhui and Nieman, Linda T. and Pappas, Leontios and Parikh, Aparna R. and Strickland, Matthew R. and Corcoran, Ryan B. and Mustelin, Tomas and Eng, George and Yilmaz, {\"O}mer H. and Matulonis, Ursula A. and Chan, Andrew T. and Skates, Steven J. and Rueda, Bo R. and Drapkin, Ronny and Klempner, Samuel J. and Deshpande, Vikram and Ting, David T. and Rout, Michael P. and LaCava, John and Walt, David R. and Burns, Kathleen H.},
  year = 2023,
  month = dec,
  journal = {Cancer Discovery},
  volume = {13},
  number = {12},
  pages = {2532--2547},
  issn = {2159-8274, 2159-8290},
  doi = {10.1158/2159-8290.CD-23-0313},
  urldate = {2024-01-11},
  abstract = {Improved biomarkers are needed for early cancer detection, risk stratification, treatment selection, and monitoring treatment response. Although proteins can be useful blood-based biomarkers, many have limited sensitivity or specificity for these applications. Long INterspersed Element-1 (LINE-1) open reading frame 1 protein (ORF1p) is a transposable element protein overexpressed in carcinomas and high-risk precursors during carcinogenesis with negligible expression in normal tissues, suggesting ORF1p could be a highly specific cancer biomarker. To explore ORF1p as a blood-based biomarker, we engineered ultrasensitive digital immunoassays that detect mid-attomolar (10-17 mol/L) ORF1p concentrations in plasma across multiple cancers with high specificity. Plasma ORF1p shows promise for early detection of ovarian cancer, improves diagnostic performance in a multianalyte panel, provides early therapeutic response monitoring in gastroesophageal cancers, and is prognostic for overall survival in gastroesophageal and colorectal cancers. Together, these observations nominate ORF1p as a multicancer biomarker with potential utility for disease detection and monitoring.},
  langid = {english},
  file = {/Users/carmenhove/Zotero/storage/373HB4LI/Taylor et al. - 2023 - Ultrasensitive Detection of Circulating LINE-1 ORF.pdf}
}

@article{taylorCellsHelminthInfection2012,
  title = {T Cells in Helminth Infection: {{The}} Regulators and the Regulated},
  author = {Taylor, Matthew D. and {van der Werf}, Nienke and Maizels, Rick M.},
  year = 2012,
  journal = {Trends in Immunology},
  volume = {33},
  number = {4},
  pages = {181--189},
  issn = {14714906},
  doi = {10.1016/j.it.2012.01.001},
  abstract = {Helminth parasites survive through a combination of parasite longevity, repeated re-infection and selective immune suppression to prevent protective Th2 responses. To counteract helminth-induced immunosuppression, and to induce long-term immunological memory, understanding of the multiple regulatory pathways within the T cell compartment is needed. Extrinsic inhibition by regulatory T cells is a key element of Th2 suppression. In addition, Th2 cells in chronic regulatory environments become functionally impaired, indicating cell-intrinsic regulation, which compromises protective Th2 memory. We discuss these pathways and consider the potential for reversing unresponsiveness through stimulatory signals or replacement by new responder populations. Future vaccine or therapeutic strategies should aim to minimize extrinsic regulatory effects and simultaneously negate Th2 anergy to drive effector responses into a long-term functionally competent state. \copyright{} 2012.},
  file = {/Users/carmenhove/Zotero/storage/XNBX948U/Trends Immunol 2012 Taylor.pdf}
}

