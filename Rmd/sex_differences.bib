@article{goswamia_etal06,
  title = {Excess Syncytiotrophoblast Microparticle Shedding Is a Feature of Early-Onset Pre-Eclampsia, but Not Normotensive Intrauterine Growth Restriction},
  author = {Goswamia, D. and Tannetta, D. S. and Magee, L. A. and Fuchisawa, A. and Redman, C. W.G. and Sargent, I. L. and {von Dadelszen}, P.},
  year = 2006,
  journal = {Placenta},
  volume = {27},
  number = {1},
  pages = {56--61},
  issn = {01434004},
  doi = {10.1016/j.placenta.2004.11.007},
  abstract = {Rationale: Syncytiotrophoblast microparticles (STBM) are shed into the maternal circulation in higher amounts in pre-eclampsia compared to normal pregnancy and are believed to be the stimulus for the systemic inflammatory response and endothelial cell damage which characterises the maternal syndrome. The excess shedding of STBM may be caused by hypoxia as a result of poor placentation, which is often a feature of pre-eclampsia. Similar placental pathology occurs in some cases of normotensive intrauterine growth restriction (nIUGR), but in the absence of maternal disease. Objective: To examine whether the shedding of STBM in nIUGR occurs to the same extent as in pre-eclampsia. Methods: A prospective case-control study in a tertiary referral centre of: 1) women with early-onset pre-eclampsia (EOPET {$<$}34 week), 2) women with late-onset pre-eclampsia (LOPET {$\geq$}34 week), 3) women with nIUGR), 4) matched normal pregnant women (NPC), and 5) non-pregnant women. An ELISA using the antitrophoblast antibody NDOG2 was used to measure STBM levels in peripheral venous plasma. Non-parametric analyses were conducted with statistical significance set at p {$<$} 0.05. Results: STBM levels rise during normal pregnancy. EOPET was associated with increased STBM levels (EOPET (median): 41 ng/ml, n = 15) compared with matched normal pregnancy (16 ng/ml, n = 15; Wilcoxon p = 0.005). LOPET (50 ng/ml, n = 10) and nIUGR (18 ng/ml, n = 8) STBM levels did not differ from matched normal pregnancy (36 ng/ml, n = 15, and 36 ng/ml, n = 8, respectively). Background levels in non-pregnant plasma were 0.49 ng/ml, n = 10. Conclusions: Increased STBM levels were found in EOPET but not in nIUGR providing further evidence for their role in the pathogenesis of the maternal syndrome. \copyright{} 2004 Elsevier Ltd. All rights reserved.},
  isbn = {0143-4004 (Print)\textbackslash r0143-4004 (Linking)},
  pmid = {16310038},
  keywords = {Apoptosis,Fetal growth retardation,Placenta,Pre-eclampsia,Pregnancy,Syncytiotrophoblast},
  file = {/Users/carmenhove/Zotero/storage/QFHXWXAC/PIIS0143400404002930.pdf}
}

