@article{sender_etal23,
  title = {The Total Mass, Number, and Distribution of Immune Cells in the Human Body},
  author = {Sender, Ron and Weiss, Yarden and Navon, Yoav and Milo, Idan and Azulay, Nofar and Keren, Leeat and Fuchs, Shai and {Ben-Zvi}, Danny and Noor, Elad and Milo, Ron},
  year = 2023,
  month = oct,
  journal = {Proceedings of the National Academy of Sciences},
  volume = {120},
  number = {44},
  pages = {e2308511120},
  issn = {0027-8424, 1091-6490},
  doi = {10.1073/pnas.2308511120},
  urldate = {2024-03-04},
  abstract = {The immune system is a complex network of cells with critical functions in health and disease. However, a comprehensive census of the cells comprising the immune system is lacking. Here, we estimated the abundance of the primary immune cell types throughout all tissues in the human body. We conducted a literature survey and integrated data from multiplexed imaging and methylome-based deconvolution. We also considered cellular mass to determine the distribution of immune cells in terms of both number and total mass. Our results indicate that the immune system of a reference 73 kg man consists of 1.8 \texttimes{} 10               12               cells (95\% CI 1.5--2.3 \texttimes{} 10               12               ), weighing 1.2 kg (95\% CI 0.8--1.9). Lymphocytes constitute 40\% of the total number of immune cells and 15\% of the mass and are mainly located in the lymph nodes and spleen. Neutrophils account for similar proportions of both the number and total mass of immune cells, with most neutrophils residing in the bone marrow. Macrophages, present in most tissues, account for 10\% of immune cells but contribute nearly 50\% of the total cellular mass due to their large size. The quantification of immune cells within the human body presented here can serve to understand the immune function better and facilitate quantitative modeling of this vital system.},
  langid = {english},
  file = {/Users/carmenhove/Zotero/storage/27TCGGDG/Sender et al. - 2023 - The total mass, number, and distribution of immune.pdf}
}

