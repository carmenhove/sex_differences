  pmid = {24381478},
  keywords = {an attending nurse to,birth outcome,doula,modern hospital maternity care,practices have,prenatal health,re-,reduced the availability of},
  file = {/Users/carmenhove/Zotero/storage/4JTU2VV2/JPE22-1_PTR_A10_049-058.pdf}
