@article{nepomnaschy_etal07a,
  title = {Stress, {{Immune Function}}, and {{Women}}'s {{Reproduction}}},
  author = {NEPOMNASCHY, P. A. and SHEINER, E. and MASTORAKOS, G. and ARCK, P. C.},
  year = 2007,
  month = may,
  journal = {Annals of the New York Academy of Sciences},
  volume = {1113},
  number = {1},
  pages = {350--364},
  issn = {0077-8923},
  doi = {10.1196/annals.1391.028},
  abstract = {Only 23\% of women will begin a successful pregnancy during the first menstrual cycle in their attempt to conceive.1 A large number of these failed reproductive attempts are attributed to a broad set of pathologies, but across studies an important proportion of unsuccessful cycles is consistently left unexplained. Stress has become a commonly cited factor when discussing unexplained reproductive failures. Early research on the effect of stress on reproduction was plagued with methodological problems and lacked a solid theoretical framework. However, recent experimental, clinical and population-based research provides new evidence and suggests novel biological mechanisms, which merit a fresh evaluation of the purported association. Here we briefly review the latest advancements in the study of the interplay between stress, the immune system and women's reproduction, discuss a proposed evolutionary origin for their relationship and examine the biological pathways that may mediate the connection between these three systems. \copyright{} 2007 New York Academy of Sciences.},
  isbn = {157331675X},
  pmid = {17978283},
  keywords = {Evolution,Immune function,Reproductive function,Stress},
  file = {/Users/carmenhove/Zotero/storage/XM46LRKV/annals.1391.028.pdf}
}

@article{Nepomnaschy2006c,
  title = {Cortisol Levels and Very Early Pregnancy Loss in Humans},
  author = {Nepomnaschy, P A and Welch, K B and McConnell, D S and Low, B S and Strassmann, B I and England, B G},
  year = 2006,
  journal = {Proceedings of the National Academy of Sciences of the United States of America},
  volume = {103},
  number = {10},
  pages = {3938--3942},
  issn = {0027-8424},
  doi = {10.1073/pnas.0511183103},
  abstract = {Maternal stress is commonly cited as an important risk factor for spontaneous abortion. For humans, however, there is little physiological evidence linking miscarriage to stress. This lack of evidence may be attributable to a paucity of research on maternal stress during the earliest gestational stages. Most human studies have focused on "clinical" pregnancy ({$>$}6 weeks after the last menstrual period). The majority of miscarriages, however, occur earlier, within the first 3 weeks after conception (approximate to 5 weeks after the last menstrual period). Studies focused on clinical pregnancy thus miss the most critical period for pregnancy continuance. We examined the association between miscarriage and levels of maternal urinary cortisol during the first 3 weeks after conception. Pregnancies characterized by increased maternal cortisol during this period (within participant analyses) were more likely to result in spontaneous abortion (P {$<$} 0.05). This evidence links increased levels in this stress marker with a higher risk of early pregnancy loss in humans.},
  isbn = {0027-8424},
  pmid = {16495411},
  keywords = {axis,corticotropin-releasing hormone,cushings-syndrome,evolutionary theory,fetomaternal conflict,implantation,laboratory psychosocial stress,miscarriage,natural selection,placentation,recurrent miscarriage,responses,spontaneous-abortion,stress,women},
  file = {/Users/carmenhove/Zotero/storage/HKBLVAZ5/2006-Cortisol_levels_and_very_early_pregnancy_loss_in_humans.pdf}
}

