@article{JoshSnodgrass2013,
  title = {Health of {{Indigenous Circumpolar Populations}}},
  author = {Josh Snodgrass, J.},
  year = 2013,
  journal = {Annual Review of Anthropology},
  volume = {42},
  number = {1},
  pages = {69--87},
  issn = {0084-6570},
  doi = {10.1146/annurev-anthro-092412-155517},
  abstract = {Indigenous circumpolar populations have experienced profound transitions in lifeways over the past half-century as a result of economic development. Although there have been positive aspects of this social transformation, most circumpolar groups today have a triple burden of disease, with a modestly elevated infectious disease level, an elevated and increasing burden of chronic conditions such as obesity and cardiovascular disease, and high rates of mental health-related challenges. The health of contemporary circumpolar populations is not easily characterized because of dramatic regional differences that stem from socioeconomic disparities among nonindigenous groups, individual population histories, lifestyle factors, environmental pollution, and underlying biological variation. Overall health and well-being range from excellent among the Sami of Sweden and Norway to extremely poor among marginalized native populations in northern Russia. Circumpolar groups today are not only threatened by continued regional economic development and pollution, but also uniquely vulnerable to global climate change. [PUBLICATIONABSTRACT]},
  isbn = {0084-6570 978-0-8243-1942-7},
  keywords = {arctic,biocultural,climate change,human biology,nutrition transition},
  file = {/Users/carmenhove/Zotero/storage/ZJGB5VQS/2013-Health_of_Indigenous_Circumpolar_Populations.pdf}
}

