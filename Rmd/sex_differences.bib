@article{trumble_etal23a,
  title = {{\emph{Apolipoprotein-}} {$\varepsilon$} {\emph{4}} Is Associated with Higher Fecundity in a Natural Fertility Population},
  author = {Trumble, Benjamin C. and Charifson, Mia and Kraft, Tom and Garcia, Angela R. and Cummings, Daniel K. and Hooper, Paul and Lea, Amanda J. and Eid Rodriguez, Daniel and Koebele, Stephanie V. and Buetow, Kenneth and Beheim, Bret and Minocher, Riana and Gutierrez, Maguin and Thomas, Gregory S. and Gatz, Margaret and Stieglitz, Jonathan and Finch, Caleb E. and Kaplan, Hillard and Gurven, Michael},
  year = 2023,
  month = aug,
  journal = {Science Advances},
  volume = {9},
  number = {32},
  pages = {eade9797},
  issn = {2375-2548},
  doi = {10.1126/sciadv.ade9797},
  urldate = {2024-02-13},
  abstract = {In many populations, the a               polipoprotein-               {$\varepsilon$}               4               (               APOE-               {$\varepsilon$}               4               ) allele increases the risk for several chronic diseases of aging, including dementia and cardiovascular disease; despite these harmful effects at later ages, the               APOE-               {$\varepsilon$}               4               allele remains prevalent. We assess the impact of               APOE-               {$\varepsilon$}               4               on fertility and its proximate determinants (age at first reproduction, interbirth interval) among the Tsimane, a natural fertility population of forager-horticulturalists. Among 795 women aged 13 to 90 (20\%               APOE-               {$\varepsilon$}               4               carriers), those with at least one               APOE-               {$\varepsilon$}               4               allele had 0.3 to 0.5 more children than ({$\varepsilon$}3/{$\varepsilon$}3) homozygotes, while those with two               APOE-               {$\varepsilon$}               4               alleles gave birth to 1.4 to 2.1 more children.               APOE-               {$\varepsilon$}               4               carriers achieve higher fertility by beginning reproduction 0.8 years earlier and having a 0.23-year shorter interbirth interval. Our findings add to a growing body of literature suggesting a need for studies of populations living in ancestrally relevant environments to assess how alleles that are deleterious in sedentary urban environments may have been maintained by selection throughout human evolutionary history.                        ,                             Among natural fertility forager-farmers, women with the               APOE-               {$\varepsilon$}               4               allele have more children, and the effect is dose dependent.},
  langid = {english},
  file = {/Users/carmenhove/Zotero/storage/MHTR4AZD/Trumble et al. - 2023 - Apolipoprotein- ε 4 is associated wi.pdf}
}

@article{Trumble2012a,
  title = {Physical Competition Increases Testosterone among {{Amazonian}} Forager-Horticulturalists: A Test of the `Challenge Hypothesis'},
  author = {Trumble, Benjamin C and Cummings, Daniel and {von Rueden}, Christopher and a. O'Connor, Kathleen and Smith, Eric A and Gurven, Michael and Kaplan, Hillard},
  year = 2012,
  month = jul,
  journal = {Proceedings of the Royal Society B: Biological Sciences},
  volume = {279},
  number = {1739},
  pages = {2907--2912},
  issn = {0962-8452},
  doi = {10.1098/rspb.2012.0455},
  abstract = {The challenge hypothesis posits that acute increases in testosterone (T) during male--male competition enhance performance and survivability while limiting the physiological costs of consistently high T. Human challenge hypothesis research focuses on young men in industrial populations, who have higher baseline T levels than men in subsistence populations. We tested whether the Tsimane, pathogenically stressed forager-horticulturalists of the Bolivian Amazon, would express acute T increases in response to physical competition. Saliva was collected from 88 Tsimane men (aged 16--59 years) before and after a competitive soccer match. Tsimane men had significantly lower baseline levels of T ( {$\beta$} = -0.41, p {$<$} 0.001) when compared with age-matched United States (US) males. Linear mixed-effects models were used to establish that T increased significantly immediately following competition ( {$\beta$} = 0.23, p {$<$} 0.001), remaining high 1 h later ( {$\beta$} = 0.09, p = 0.007); equivalent to 30.1 and 15.5 per cent increases in T, respectively. We did not find larger increases in T among winners ( p = 0.412), although T increases were positively associated with self-rated performance ( {$\beta$} = 9.07, p = 0.004). These results suggest that despite lower levels of T than US males, Tsimane males exhibit acute increases in T at the same relative magnitude reported by studies in industrialized settings, with larger increases in T for those who report better individual performance.},
  isbn = {0962845214712954},
  pmid = {22456888},
  keywords = {challenge hypothesis,competition,testosterone,tsimane},
