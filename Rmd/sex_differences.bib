@article{aydin_etal18,
  title = {Transfer and {{Integration}} of {{Breast Milk Stem Cells}} to the {{Brain}} of {{Suckling Pups}}},
  author = {Ayd{\i}n, Mehmet {\c S}erif and Yi{\u g}it, Esra Nur and Vatanda{\c s}lar, Emre and Erdo{\u g}an, Ender and {\"O}zt{\"u}rk, G{\"u}rkan},
