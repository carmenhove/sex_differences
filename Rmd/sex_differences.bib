ax ME} and Hosgood, {\relax HD} and Chen, B and Absher, D and Assimes, T and Horvath, S and Gruver, {\relax AL} and Hudson, {\relax LL} and Sempowski, {\relax GD} and Gurven, M and Kaplan, H and Winking, J and Finch, C and Crimmins, {\relax EM} and Gurven, M and Blackwell, {\relax AD} and Rodriguez, {\relax DE} and Stieglitz, J and Kaplan, H and Markides, {\relax KS} and Coreil, J and Sorlie, {\relax PD} and Backlund, E and Johnson, {\relax NJ} and Rogot, E and Arias, E and Eschbach, K and Schauman, {\relax WS} and Backlund, {\relax EL} and Sorlie, {\relax PD} and Ruiz, {\relax JM} and Steffen, P and Smith, {\relax TB} and Crimmins, {\relax EM} and Kim, {\relax JK} and Alley, {\relax DE} and Karlamangla, A and Seeman, T and Contreras, G and Alaez, C and Murguia, A and Garcia, D and Flores, H and Gorodezky, C and Dowd, {\relax JB} and Aiello, {\relax AE} and Alley, {\relax DE} and Dowd, {\relax JB} and Zajacova, A and Aiello, A and Johnson, {\relax NE} and Yao, L and Robert, {\relax SA} and Fenelon, A and Gurven, M and Jaeggi, {\relax AV} and Kaplan, H and Cummings, D and Blackwell, {\relax AD} and Trumble, {\relax BC} and Suarez, I Maldonado and Stieglitz, J and Beheim, B and Snodgrass, {\relax JJ} and Gurven, M and Kaplan, H and Supa, {\relax AZ} and Case, A and Paxson, C and Oksuzyan, A and Juel, K and Vaupel, {\relax JW} and Christensen, K and Crimmins, {\relax EM} and Kim, {\relax JK} and Langa, {\relax KM} and Weir, {\relax DR} and Simpkin, {\relax AJ} and Hemani, G and Suderman, M and Gaunt, {\relax TR} and Lyttleton, O and McArdle, {\relax WL} and Klemera, P and Doubal, S and Pidsley, R and Wong, CC Y and Volta, M and Lunnon, K and Mill, J and Schalkwyk, {\relax LC} and Costello, S and Cockburn, M and Bronstein, J and Zhang, X and Ritz, B and Liu, J and Morgan, M and Hutchison, K and Calhoun, {\relax VD} and Hernandez, D and Nalls, M and Gibbs, J and Arepalli, S and Brug, M and Chong, S and Bennett, {\relax DA} and Schneider, {\relax JA} and Arvanitakis, Z and Wilson, {\relax RS} and Dunning, M and {Barbosa-Morais}, N and Lynch, A and Tavare, S and Ritchie, M and Appay, V and Lier, {\relax RA} and Sallusto, F and Roederer, M and Heyn, H and Moran, S and {Hernando-Herraez}, I and Sayols, S and Gomez, A and Sandoval, J and Monk, D and Hata, K and Bonet, T Marques and Wang, L and Esteller, M and Viechtbauer, W},
  year = 2016,
  journal = {Genome Biology},
  volume = {17},
  number = {1},
  pages = {171},
  publisher = {Genome Biology},
  issn = {1474-760X},
  doi = {10.1186/s13059-016-1030-0},
  abstract = {Epigenetic biomarkers of aging (the ``epigenetic clock'') have the potential to address puzzling findings surrounding mortality rates and incidence of cardio-metabolic disease such as: (1) women consistently exhibiting lower mortality than men despite having higher levels of morbidity; (2) racial/ethnic groups having different mortality rates even after adjusting for socioeconomic differences; (3) the black/white mortality cross-over effect in late adulthood; and (4) Hispanics in the United States having a longer life expectancy than Caucasians despite having a higher burden of traditional cardio-metabolic risk factors. We analyzed blood, saliva, and brain samples from seven different racial/ethnic groups. We assessed the intrinsic epigenetic age acceleration of blood (independent of blood cell counts) and the extrinsic epigenetic aging rates of blood (dependent on blood cell counts and tracks the age of the immune system). In blood, Hispanics and Tsimane Amerindians have lower intrinsic but higher extrinsic epigenetic aging rates than Caucasians. African-Americans have lower extrinsic epigenetic aging rates than Caucasians and Hispanics but no differences were found for the intrinsic measure. Men have higher epigenetic aging rates than women in blood, saliva, and brain tissue. Epigenetic aging rates are significantly associated with sex, race/ethnicity, and to a lesser extent with CHD risk factors, but not with incident CHD outcomes. These results may help elucidate lower than expected mortality rates observed in Hispanics, older African-Americans, and women.},
  pmid = {27511193},
  keywords = {Animal Genetics and Genomics,Bioinformatics,Evolutionary Biology,Human Genetics,Microbial Genetics and Genomics,Plant Genetics & Genomics},
  file = {/Users/carmenhove/Zotero/storage/HCEHPYHQ/art%3A10.1186%2Fs13059-016-1030-0.pdf}
}

