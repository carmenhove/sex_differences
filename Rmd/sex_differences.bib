@article{liangProinflammatoryAntiinflammatoryCytokine2015,
  title = {The Pro-Inflammatory and Anti-Inflammatory Cytokine Profile in Peripheral Blood of Women with Recurrent Implantation Failure},
  author = {Liang, Pei-Yan and Diao, Liang-Hui and Huang, Chun-Yu and Lian, Ruo-Chun and Chen, Xian and Li, Guan-Gui and Zhao, Jin and Li, Yu-Ye and He, Xue-bing and Zeng, Yong},
