@article{uppal_etal03,
  title = {Normal Values of {{CD4}} and {{CD8}} Lymphocyte Subsets in Healthy Indian Adults and the Effects of Sex, Age, Ethnicity, and Smoking},
  author = {Uppal, S. S. and Verma, Shashi and Dhot, P. S.},
