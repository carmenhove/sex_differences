  keywords = {Cesarean section,Duration of pregnancy,Gestational age,Labor induction,Late preterm,Premature rupture of the membranes,Prematurity},
  file = {/Users/carmenhove/Zotero/storage/LHE8BVVY/bca13e60cd92e08a7af77e7cfd075b532be4.pdf}
}

@article{davis_etal99,
