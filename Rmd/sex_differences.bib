@article{burdge_etal07,
  title = {Epigenetic Regulation of Transcription: A Mechanism for Inducing Variations in Phenotype (Fetal Programming) by Differences in Nutrition during Early Life?},
  author = {Burdge, Graham C and Hanson, Mark A and {Slater-Jefferies}, Jo L and Lillycrop, Karen A},
