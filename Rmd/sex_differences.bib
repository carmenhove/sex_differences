@article{pan_etal19,
  title = {Discovery and {{Validation}} of a {{Novel Neutrophil Activation Marker Associated}} with {{Obesity}}},
  author = {Pan, Yue and Choi, Jeong Hyeon and Shi, Huidong and Zhang, Liwen and Su, Shaoyong and Wang, Xiaoling},
  year = 2019,
