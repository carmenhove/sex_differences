@article{faasMonocytesMacrophagesPregnancy2014,
  title = {Monocytes and {{Macrophages}} in {{Pregnancy}} and {{Pre-Eclampsia}}},
  author = {Faas, Marijke M. and Spaans, Floor and De Vos, Paul},
