@article{Steckel2014a,
  title = {Methodological {{Perspectives}} on the {{Second Epidemiologic Transition}}: {{Current}} and {{Future Research}}},
  author = {Steckel, Richard H.},
  year = 2014,
  journal = {Modern Environments and Human Health: Revisiting the Second Epidemiologic Transition},
  volume = {9781118504},
  number = {1945},
  pages = {369--376},
  doi = {10.1002/9781118504338.ch20},
  abstract = {This chapter reviews the intellectual history of the demographic transition to gain insights into the need for current and future research on the second epidemiologic transition. It begins with a discussion on the research of demographic transition. In the second phase of the demographic transition in developing countries, fertility remained high relative to mortality such that world population was scheduled to double from two to four billion between 1930 and 1975, most of which was forecast to occur in poor countries. Research understandably focused on fertility as a way to manage the population problem. Communicable diseases such as smallpox, cholera, and typhoid often receive the spotlight in research on the transition, but prior to the 20th century, poor methods of food preservation led to spoilage, and water supplies in many communities were frequently infested by pathogens, creating less spectacular scenes of death.},
  isbn = {9781118504338},
  keywords = {Communicable diseases,Demographic transition,Second epidemiologic transition},
  file = {/Users/carmenhove/Zotero/storage/D3KAECI9/ch20.pdf}
}

@article{steele_goetzl14,
