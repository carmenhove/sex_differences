  author = {Kraus, Thomas A. and Engel, Stephanie M. and Sperling, Rhoda S. and Kellerman, Lisa and Lo, Yungtai and Wallenstein, Sylvan and Escribese, Maria M. and Garrido, Jose L. and Singh, Tricia and Loubeau, Martine and Moran, Thomas M.},
  year = 2012,
