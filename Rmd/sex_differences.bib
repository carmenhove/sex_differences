  pages = {603--622},
  issn = {0003-0147},
  doi = {10.1086/285346},
  abstract = {It has been argued that females should be able to choose parasite-resistant mates on the basis of the quality of male secondary sexual characters and that such signals must be costly handicaps in order to evolve. To a large extent, handicap hypotheses have relied on energetic explanations for these costs. Here, the authors present a phenomenological model, operating on an intraspecific level, which views the cost of secondary sexual development from an endocrinological perspective. The primary androgenic hormone, testosterone, stimulates development of characteristics used in sexual selection while reducing immunocompetence. This "double-edged sword' creates a physiological trade-off that influences and is influenced by parasite burden. The authors propose a negative-feedback loop between signal intensity and parasite burden by suggesting that testosterone-dependent signal intensity is a plastic response, modified in accordance with the competing demands of the potential costs of parasite infection versus that of increased reproductive success afforded by exaggerated signals. This trade-off is intimately involved in the evolution of secondary sexual characteristics and may explain some of the equivocal empirical results that have surfaced in attempts to quantify parasites' effect on sexual selection. -Authors},
  file = {/Users/carmenhove/Zotero/storage/TZN43BID/Parasites_Bright_Males_and_the_Immunocompetence_Ha-2.pdf;/Users/carmenhove/Zotero/storage/ZU3NIITX/Parasites_Bright_Males_and_the_Immunocompetence_Ha.pdf}
}

@article{fong_etal22,
