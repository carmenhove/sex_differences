  author = {Furcron, Amy Eunice and Romero, Roberto and Mial, Tara N. and Balancio, Amapola and Panaitescu, Bogdan and Hassan, Sonia S. and Sahi, Aashna and Nord, Claire and {Gomez-Lopez}, Nardhy},
