@article{hughes_etal11,
  title = {Behavioral Mechanisms and Morphological Symptoms of Zombie Ants Dying from Fungal Infection},
  author = {Hughes, David P. and Andersen, Sandra B. and {Hywel-Jones}, Nigel L. and Himaman, Winanda and Billen, Johan and Boomsma, Jacobus J.},
