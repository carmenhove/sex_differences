@article{Boulinier2008a,
  title = {Maternal Transfer of Antibodies: Raising Immuno-Ecology Issues},
  author = {Boulinier, Thierry and Staszewski, Vincent},
  year = 2008,
  journal = {Trends in Ecology and Evolution},
  volume = {23},
  number = {5},
  pages = {282--288},
  issn = {01695347},
  doi = {10.1016/j.tree.2007.12.006},
  abstract = {The transfer of antibodies from mother to offspring has broad potential implications in evolutionary ecology, from the adaptive value of maternal effects to the role of transgenerational plasticity in host-parasite interactions. Recent contributions have addressed key issues such as environmental and genetic factors affecting the amount of antibodies transferred and whether maternal antibodies affect offspring immunity, but little is still known about the implications of the maternal transfer of antibodies in natural populations. By its position at the crossroads between population ecology, animal science, medicine and epidemiology, current studies of the role of the maternal transfer of antibodies highlight how research in ecological immunology needs to combine functional and evolutionary approaches while also keeping in mind ecological settings. ?? 2007 Elsevier Ltd. All rights reserved.},
