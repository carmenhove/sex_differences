  author = {Vasunilashorn, Sarinnapha and Finch, Caleb E and Crimmins, Eileen M and Vikman, Suvi A and Stieglitz, Jonathan and Gurven, Michael and Kaplan, Hillard S and Allayee, Hooman},
  year = 2011,
  journal = {Biodemography and social biology},
  volume = {57},
