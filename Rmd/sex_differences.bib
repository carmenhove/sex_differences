@article{Wilbur2011,
  title = {Humor in Romantic Contexts: Do Men Participate and Women Evaluate?},
  author = {Wilbur, Christopher J and Campbell, Lorne},
  year = 2011,
  journal = {Personality \& social psychology bulletin},
  volume = {37},
