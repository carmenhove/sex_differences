  author = {Tidi{\`e}re, Morgane and Badruna, Ad{\`e}le and Fouchet, David and Gaillard, Jean Michel and Lema{\^i}tre, Jean Fran{\c c}ois and Pontier, Dominique},
  year = 2020,
  journal = {Trends in Parasitology},
  volume = {36},
  number = {8},
  pages = {668--676},
  publisher = {Elsevier Ltd},
  issn = {14715007},
  doi = {10.1016/j.pt.2020.05.004},
  abstract = {Understanding the origin of sex differences in lifespan and aging patterns remains a salient challenge in both biogerontology and evolutionary biology. Different factors have been studied but the potential influence of pathogens has never been investigated. Sex differences, especially in hormones and resource allocation, generate a differential response to pathogens and thereby shape sex differences in lifespan or aging. We provide an integrative framework linking host pathogenic environment with both sex-specific selections on immune performance and mortality trajectories. We propose future directions to fill existing knowledge gaps about mechanisms that link sex differences, not only to exposition and sensitivity to pathogens, but also to mortality patterns, whilst emphasizing the urgent need to consider the role of sex in medicine.},
  pmid = {32540194},
  keywords = {immunosenescence,life-history traits,lifespan,medicine,pathogen exposure},
  file = {/Users/carmenhove/Zotero/storage/RBYHEHN2/1-s2.0-S147149222030132X-main.pdf}
}

