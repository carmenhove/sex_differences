@article{bao_etal03,
  title = {Diurnal Rhythm of Free Estradiol during the Menstrual Cycle},
  author = {Bao, Ai Min and Liu, Rong Yu and {van Someren}, Eus J.W. and Hofman, Michel A. and Cao, Yun Xia and Zhou, Jiang Ning},
  year = 2003,
  journal = {European Journal of Endocrinology},
  volume = {148},
  number = {2},
  pages = {227--232},
  issn = {08044643},
  doi = {10.1530/eje.0.1480227},
  abstract = {Objective: To investigate the diurnal rhythm of estrogens in normally cyclic women during reproductive life. Design: Multiple saliva sampling in normally cyclic healthy women during reproductive life at different phases of their menstrual cycles was carried out. Methods: Salivary estradiol was measured by radioimmunoassay in samples collected every 2 h for 24 h from 15 normally cyclic healthy women during reproductive life during the menstrual phase, the late follicular/peri-ovulation phase, the early to mid luteal phase and the late luteal phase, respectively, of their menstrual cycles. The levels of salivary estradiol were analyzed by means of periodic regression. Results: A daily biological rhythm of free estradiol was found after quantification with a nonlinear periodic regression model. The observed diurnal free estradiol rhythm consists of two major components: an asymmetrically peaked diurnal cycle and ultradian harmonics in the range of 6 to 12 h. The diurnal and ultradian rhythms were remarkably consistent throughout the menstrual cycle in terms of mesor (24 h mean level), peak width and amplitude. There was a tendency for the 24-h rhythm acrophases to converge in the early morning, while the acrophase of the menstrual phase occurred significantly later than in the late follicular/peri-ovulation phase. Conclusions: The diurnal rhythm of estradiol has a similar complex temporal organization for different menstrual phases. The menstrual cycle mainly modulates the acrophase of the diurnal rhythm.},
  pmid = {12590642},
  file = {/Users/carmenhove/Zotero/storage/LQLD4LIX/%5B1479683X%20-%20European%20Journal%20of%20Endocrinology%5D%20Diurnal%20rhythm%20of%20free%20estradiol%20during%20the%20menstrual%20cycle.pdf}
}

