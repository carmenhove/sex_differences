@article{Crawford2003,
  title = {Gender and Humor in Social Context},
  author = {Crawford, Mary},
  year = 2003,
  journal = {Journal of Pragmatics},
  volume = {35},
  number = {9},
  pages = {1413--1430},
  issn = {03782166},
  doi = {10.1016/S0378-2166(02)00183-2},
  abstract = {This critical review of research on gender and humor describes a theoretically and pragmatically fruitful framework for studying the intersection of these topics. Gender is conceived as a system of meanings that influences access to power, status, and material resources. Humor is conceived as a mode of discourse and a strategy for social interaction. Within this theoretical framework, it is argued that women and men use humor in same-gender and mixed-gender settings as one of the tools of gender construction. Through it and other means, they constitute themselves as masculine men and feminine women. At the same time, the unique properties of humor make it a valuable tool of gender deconstruction. In the political humor of the women's movement, and in the conversational humor of women friends, resistance to dominant social constructions of gender can be voiced. \copyright{} 2002 Elsevier Science B.V. All rights reserved.},
  isbn = {0378-2166},
  keywords = {Community of practice,Feminism,Gender construction,Humor,Male-female differences,Social context},
  file = {/Users/carmenhove/Zotero/storage/MUA5MMD4/2003-Gender_and_humor_in_social_context.pdf}
}

