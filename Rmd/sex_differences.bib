  author = {Arbib, Nissim and Aviram, Amir and {Gabbay Ben-Ziv}, Rinat and Sneh, Orly and Yogev, Yariv and Hadar, Eran},
  year = 2016,
  journal = {Journal of Maternal-Fetal \& Neonatal Medicine},
  volume = {29},
  number = {18},
  pages = {2904--2908},
  issn = {14767058},
  doi = {10.3109/14767058.2015.1110572},
  abstract = {{$<$}bold{$>$}Objective: {$<$}/bold{$>$}To explore post-partum white blood cell (WBC) count, and possible factors affecting it.{$<$}bold{$>$}Study Design: {$<$}/bold{$>$}Retrospective cohort analysis of 12\,079 healthy women, delivering a singleton term fetus with an uncomplicated course of labor, delivery and puerperium. All women delivered in a single tertiary, university-affiliated medical center from 2009 to 2014. Student's t-test, Mann-Whitney's U-test, {$\chi$}(2) test and ANOVA were used to compare between variables. Multiple variable analyses was performed to allow adjustment for potential covariates and confounders. The main outcome measures included post-partum WBC count and the difference in the post-partum versus ante-partum WBC count, in association to mode of delivery, type of analgesia, timing of cesarean delivery and perineal trauma.{$<$}bold{$>$}Results: {$<$}/bold{$>$}The mean post-partum WBC count was 13.39\,\textpm\,.24\,\texttimes\,10(9)/L (range 1.20-37.30\,\texttimes\,10(9)/L). There is a significant increase in the WBC after delivery (2.1 9\,\textpm\,3.33\,\texttimes\,10(9)/L) with significant differences according to mode of delivery (2.34\,\textpm\,3.48, 3.32\,\textpm\,3.69 and 1.6 0\,\textpm\,2.87\,\texttimes\,10(9)/L for spontaneous, assisted and cesarean deliveries. Multiple variables can affect post-partum leukocytosis, including: age, parity, gestational age, mode of delivery, type of anesthesia, timing of cesarean delivery in relation to labor onset and the extent of perineal trauma.{$<$}bold{$>$}Conclusions: {$<$}/bold{$>$}Post-partum leukocytosis is a physiological phenomenon with a wide normal variation and multiple contributing factors. As a single parameter, post-partum leukocytosis should not prompt further work up. [ABSTRACT FROM AUTHOR]},
  keywords = {BLOOD cell count,CHILDBIRTH,Delivery,DELIVERY (Obstetrics),labor,LABOR (Obstetrics),LEUKOCYTE count,leukocytosis,post-partum,RESEARCH,white blood cells},
  file = {/Users/carmenhove/Zotero/storage/HEXGNRNB/The effect of labor and delivery on white blood cell count.pdf}
