  volume = {19},
  number = {1},
  eprint = {1512.03704v2},
  pages = {111--145},
  issn = {0066-4162},
  doi = {10.1146/annurev.es.19.110188.000551},
  abstract = {Herbivory has a profound effect on seaweeds in both temperate and tropical\textbackslash r\textbackslash ncommunities (II, 17,21,33,43,47,80, 124). This is especially true on coral\textbackslash r\textbackslash nreefs where 60-97\% (II, 42) of the total seaweed production may be removed\textbackslash r\textbackslash nby herbivores. To persist in marine communities, seaweeds must escape,\textbackslash r\textbackslash ndeter, or tolerate herbivory. The ecological and evolutionary importance of\textbackslash r\textbackslash nspatial and temporal escapes has been extensively studied for seaweeds and\textbackslash r\textbackslash nadequately reviewed in the recent literature.\textbackslash r\textbackslash nApproximately 500--600 secondary compounds have been isolated from\textbackslash r\textbackslash nmarine algae (23, 24, 123). Many of these compounds possess strong biological\textbackslash r\textbackslash nactivities in laboratory assays (3, 23, 24, 27, 45, 52, 93, 104); however,\textbackslash r\textbackslash ntheir ecological functions under natural conditions have been addressed only\textbackslash r\textbackslash nrecently. Seaweed secondary metabolites may function as herbivore deterrents\textbackslash r\textbackslash n(see below) or as allelopathic and antifouling agents (57, 85, 1 28).\textbackslash r\textbackslash nRecent investigations (52, 1 16) suggest that the primary function of many\textbackslash r\textbackslash nof these compounds is to deter herbivory. However, secondary metabolites\textbackslash r\textbackslash nalso may have multiple or alternate functions. Below we review the available\textbackslash r\textbackslash ninformation on chemically mediated seaweed-herbivore interactions ,\textbackslash r\textbackslash ncompare their effects in marine vs terrestrial communities, and interpret the\textbackslash r\textbackslash n.robustness of present plant-herbivore theory in light of the emerging marine\textbackslash r\textbackslash npatterns. \textbackslash r\textbackslash n},
