@article{Jentsch-Ullrich2005a,
  title = {Lymphocyte Subsets' Reference Ranges in an Age- and Gender-Balanced Population of 100 Healthy Adults - {{A}} Monocentric {{German}} Study},
  author = {{Jentsch-Ullrich}, Kathleen and Koenigsmann, Michael and Mohren, Martin and Franke, Astrid},
  year = 2005,
  journal = {Clinical Immunology},
  volume = {116},
  number = {2},
  pages = {192--197},
  issn = {15216616},
  doi = {10.1016/j.clim.2005.03.020},
  abstract = {Region-specific reference ranges for adult peripheral blood lymphocyte subsets have been established in few countries around the world, but most studies were restricted to younger adults for monitoring of HIV patients. The aim of this investigation was to establish age- and gender-specific reference ranges for healthy adults. Lymphocyte subsets were examined in 100 healthy volunteers (50 males, 50 females) aged 19-85 years by two-color flow cytometric analysis with a FACSCalibur. A statistically significant decline in the mean numbers of CD3+/CD8+ T cells and CD19+ B cells was observed beyond an age of 50 years, whereas the mean counts of NK cells and CD4+/CD8+ ratio significantly increased beyond the age of 50. Females ??? 50 years had significantly higher mean CD4+ T cell counts and lower NK cell counts than males ??? 50 years. Based on these results, we established reference values for three subgroups: males ??? 50 years, females ??? 50 years, and males/females {$>$} 50 years. ?? 2005 Elsevier Inc. All rights reserved.},
  isbn = {1521-6616 (Print)\textbackslash r1521-6616 (Linking)},
  pmid = {15993366},
  keywords = {Age,Gender,Lymphocyte subsets,Reference range},
  file = {/Users/carmenhove/Zotero/storage/C43XJ5TP/2005-Lymphocyte_subsets_reference_ranges_in_an_age-_and_gender-balanced_population_of_100_healthy_adults_-_A_monocentric.pdf}
}

