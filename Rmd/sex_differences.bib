  author = {Monceau, Karine and {Dechaume-Moncharmont}, Fran{\c c}ois Xavier and Moreau, J{\'e}r{\^o}me and Lucas, Camille and Capoduro, R{\'e}mi and Motreuil, S{\'e}bastien and Moret, Yannick},
  year = 2017,
  journal = {Journal of Animal Ecology},
  volume = {86},
